# Per-project Kaiten settings (.kaiten.env)
#
# This file holds project business logic only (space/board IDs), so it is
# safe to commit. Credentials (KAITEN_API_URL, KAITEN_API_TOKEN) belong in
# ~/.kaiten/config or environment variables.
#
# Usage: cp .kaiten.env.example .kaiten.env

# Default space for all card operations
KAITEN_DEFAULT_SPACE_ID=12345

# Default board for card creation
KAITEN_DEFAULT_BOARD_ID=67890

# Optional allowlists: operations outside these IDs are rejected
# KAITEN_ALLOWED_SPACE_IDS=12345,67890
# KAITEN_ALLOWED_BOARD_IDS=111,222,333
