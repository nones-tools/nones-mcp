# ============================================
# REQUIRED
# ============================================

# Kaiten API URL of your workspace
# Example: https://company.kaiten.ru/api/latest
KAITEN_API_URL=https://your-domain.kaiten.ru/api/latest

# API token
# Get one: Kaiten -> Profile settings -> API tokens -> Create token
KAITEN_API_TOKEN=your_api_token_here

# ============================================
# OPTIONAL
# ============================================

# Default space, used when spaceId is not passed explicitly
KAITEN_DEFAULT_SPACE_ID=12345

# Default board, used when boardId is not passed explicitly
KAITEN_DEFAULT_BOARD_ID=67890

# Comma-separated allowlist of spaces; operations outside it are rejected
KAITEN_ALLOWED_SPACE_IDS=12345,67890

# Comma-separated allowlist of boards; operations outside it are rejected
KAITEN_ALLOWED_BOARD_IDS=111,222,333

# Log level: error | warn | info | debug (default: info)
# KAITEN_LOG_LEVEL=info
