{
  "name": "@nones/opencode-mcp",
  "version": "0.4.0",
  "type": "module",
  "description": "MCP server, session CLI, and SDK for an existing OpenCode service",
  "license": "MIT",
  "author": "ZeiZel <valera2003lvov@yandex.ru>",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "opencode-mcp": "./dist/cli.js",
    "oc2-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets/banner.svg"
  ],
  "scripts": {
    "build": "bun build src/cli.ts src/index.ts --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json && node scripts/fix-declaration-imports.mjs",
    "test": "bun test",
    "test:package": "bun test tests/package.test.ts tests/bun-package.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "pack": "bun run build && npm pack",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode/client": "2.4.2",
    "commander": "15.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeiZel/opencode-mcp.git"
  }
}
